     "r": "よし"
    },
    {
     "a": "怨",
     "r": "うらみ"
    },
    {
     "a": "覓",
     "r": "もと"
    },
    {
     "a": "屡",
     "r": "しばしば"
    },
    {
     "a": "穿",
     "r": "うが"
    }
   ]
  },
  {
   "id": "aozora-048398-000031",
   "pid": "",
   "pages": [],
   "no": 31,
   "vol": "上の二",
   "kotobagaki": "",
   "author": "",
   "text": "要こそあれと身を翻して、早くも洞中に潜むと与に、燈の主は間近に来りぬ。一個の婦人なり。予は燈影を見し始より、今夜満願に当るべき咒詛主の、驚破や来ると思いしなりき。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose",
   "ruby": [
    {
     "a": "与",
     "r": "とも"
