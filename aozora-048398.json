     "r": "たしか"
    },
    {
     "a": "軈",
     "r": "やが"
    },
    {
     "a": "近",
     "r": "ちかづ"
    }
   ]
  },
  {
   "id": "aozora-048398-000029",
   "pid": "",
   "pages": [],
   "no": 29,
   "vol": "上の二",
   "kotobagaki": "",
   "author": "",
   "text": "予が曩に諸君に向いて、凄まじきものの経験を有せりと謂いしは是なり。",
